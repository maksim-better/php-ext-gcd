# T003: 可复现 ZTS PHP 8.4 构建镜像（从 php-src PHP-8.4 源码编译 --enable-zts）
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    git ca-certificates autoconf bison re2c pkg-config build-essential \
    libcurl4-openssl-dev libssl-dev libxml2-dev libsqlite3-dev zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

# php-src 在宿主机克隆（docker build 网络无法访问 github），再 COPY 进镜像
COPY php-src /usr/src/php

WORKDIR /usr/src/php

RUN ./buildconf --force \
    && ./configure \
       --enable-zts \
       --disable-all \
       --enable-cli \
       --enable-embed \
       --enable-curl \
       --with-curl \
       --with-openssl \
       --enable-pcntl \
       --enable-posix \
       --enable-sockets \
       --enable-filter \
       --enable-tokenizer \
       --enable-ctype \
       --without-pear \
    && make -j"$(nproc)" \
    && make install

RUN php -v && php -i | grep 'Thread Safety' && php -r 'echo "PHP_ZTS=", PHP_ZTS, "\n";'